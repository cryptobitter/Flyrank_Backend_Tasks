# PostgreSQL Container Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tasks_db
POSTGRES_PORT=5432

# Application Database Connection String
# Inside Docker Compose network, host is 'db'. For host-machine testing, use 'localhost'.
DATABASE_URL=postgresql://postgres:postgres@db:5432/tasks_db

# Stretch Goal: Redis Connection String (prepared for Week 4 caching/jobs)
REDIS_URL=redis://redis:6379/0

# Storage backend selector ('postgres' or 'memory')
STORAGE_BACKEND=postgres
