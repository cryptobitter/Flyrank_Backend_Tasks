# AI Image Understanding & Content Matching Engine Configuration
# Copy this file to .env and configure your environment

# Server
PORT=8000
HOST=0.0.0.0
BASE_URL=http://localhost:8000
ENVIRONMENT=development

# Database
DATABASE_URL=sqlite:///./data/image_engine.db

# AI Vision & Embeddings Configuration ($0 Free Stack)
# If GEMINI_API_KEY is provided, uses Google Gemini Flash; otherwise uses local embedding/vision engine
GEMINI_API_KEY=
VISION_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=text-embedding-004

# Mismatch Guard & Threshold Parameters
SIMILARITY_THRESHOLD=0.30
CONFIDENCE_THRESHOLD=0.70
MAX_BATCH_WORKERS=4

# Per-Call Cost Tracking Estimates (USD)
COST_PER_VISION_CALL_USD=0.0001
COST_PER_EMBED_CALL_USD=0.00002
