# LLM Usage Metering & Billing Engine - Environment Variables Configuration
# Copy this file to .env for local runtime configuration.
# Never commit actual secret keys to version control!

# Server Host & Port
PORT=8000
HOST=0.0.0.0

# Database Persistence Path (SQLite file or PostgreSQL connection string)
DATABASE_PATH=billing.db
# DATABASE_URL=postgresql://billing_user:billing_pass@localhost:5432/billing_db

# Stripe Test Mode Keys (Never use live keys; test cards only: 4242 4242 4242 4242)
STRIPE_SECRET_KEY=sk_test_placeholder_key_for_local_eval
STRIPE_WEBHOOK_SECRET=whsec_test_secret_for_local_eval_signature_verification_123456

# Pinned Pricing Configurations (micro-dollars per 1,000,000 tokens)
INPUT_TOKEN_RATE_PER_MILLION_MICROS=150000
CACHED_INPUT_TOKEN_RATE_PER_MILLION_MICROS=37500
OUTPUT_TOKEN_RATE_PER_MILLION_MICROS=600000
REASONING_TOKEN_RATE_PER_MILLION_MICROS=600000
API_CALL_BASE_FEE_MICROS=100
