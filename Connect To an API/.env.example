# ==============================================================================
# Connect To an API — Environment Configuration
# Two Free Model Providers (No credit card ever required)
# ==============================================================================

# Provider Choice: 'groq' | 'gemini' | 'mock' (default: mock for instant offline testing)
LLM_PROVIDER=mock

# Provider 1: Groq Console (Llama 3.3 70B / Llama 3.1 8B)
# Get free key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_free_groq_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Provider 2: Google AI Studio (Gemini 1.5 Flash / Gemini 2.0 Flash)
# Get free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy_your_free_gemini_key_here
GEMINI_MODEL=gemini-1.5-flash

# Resilience & Reliability Tuning
LLM_TIMEOUT_SECONDS=8.0
LLM_CONNECT_TIMEOUT_SECONDS=3.0
LLM_MAX_RETRIES=3
LLM_BASE_BACKOFF_SECONDS=0.5
