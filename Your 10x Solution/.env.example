# Server Settings
PORT=8000
HOST=0.0.0.0
DEBUG=True

# Database (Default: local SQLite database)
DATABASE_URL=sqlite:///./sentinel_ai.db

# Authentication (JWT)
JWT_SECRET=super-secret-jwt-key-sentinel-ai-flyrank-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Provider Configuration (Optional: zero-config offline fallback included)
LLM_PROVIDER=mock
GROQ_API_KEY=
GEMINI_API_KEY=

# Webhook Alerting
ALERT_WEBHOOK_URL=http://localhost:8000/api/v1/webhooks/mock-slack
WEBHOOK_HMAC_SECRET=sentinel-hmac-secret-2026

# Cache TTL in seconds
CACHE_TTL_SECONDS=300
