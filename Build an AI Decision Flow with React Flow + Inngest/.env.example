# OpenAI API Key (Optional: system includes high-fidelity mock LLM fallback when not provided)
OPENAI_API_KEY=your_openai_api_key_here

# Inngest Event Key and Signing Key (For production / cloud deployment)
INNGEST_EVENT_KEY=local
INNGEST_SIGNING_KEY=

# Inngest Dev Server URL
NEXT_PUBLIC_INNGEST_SERVER_URL=http://localhost:8288
