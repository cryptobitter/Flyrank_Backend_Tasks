# Embeddable Widget & Lead-Capture Platform Configuration
# Copy this file to .env and configure your environment

# Server Configuration
PORT=8000
HOST=0.0.0.0
BASE_URL=http://localhost:8000
ENVIRONMENT=development

# Database Configuration (SQLite by default, or PostgreSQL via postgresql://user:pass@localhost:5432/widgets)
DATABASE_URL=sqlite:///./data/widget_platform.db

# Security & Authentication
JWT_SECRET=super_secret_jwt_signing_key_at_least_32_characters_long_for_security
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Abuse Protection & Rate Limiting (Per IP and Per Widget)
RATE_LIMIT_IP_MAX_REQUESTS=15
RATE_LIMIT_IP_WINDOW_SECONDS=60
RATE_LIMIT_WIDGET_MAX_REQUESTS=60
RATE_LIMIT_WIDGET_WINDOW_SECONDS=60
MAX_PAYLOAD_SIZE_BYTES=102400

# Geolocation Fallback Chain (Provider A -> Provider B -> Degraded Success)
GEO_PROVIDER_A_ENABLED=true
GEO_PROVIDER_A_URL=http://ip-api.com/json/{ip}
GEO_PROVIDER_B_ENABLED=true
GEO_PROVIDER_B_URL=https://ipapi.co/{ip}/json/

# Safe Side Effects (Email / Webhook Notification)
NOTIFICATION_ENABLED=true
NOTIFICATION_EMAIL_TO=alerts@example.com
NOTIFICATION_WEBHOOK_URL=https://webhook.site/placeholder
SIMULATE_SIDE_EFFECT_FAILURE=false
