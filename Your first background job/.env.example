# AI Model Provider Configuration (Optional - offline fallback is built-in)
# Options: "mock", "groq", "gemini"
LLM_PROVIDER=mock

# Groq API Key (Optional)
GROQ_API_KEY=

# Gemini API Key (Optional)
GEMINI_API_KEY=

# Worker Configuration
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_SEC=0.2
MAX_JOB_RETRIES=3
BASE_RETRY_BACKOFF_SEC=0.5

# Alerting Configuration
ALERT_WEBHOOK_URL=
ALERT_EMAIL=alerts@flyrank.internal
ALERT_CHANNEL=slack-ops-pager
